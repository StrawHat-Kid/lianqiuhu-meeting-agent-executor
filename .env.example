# 执行器启动配置
PORT=18035
# 会议智能体正式 AGENT 待产品方案确认后填写。
AGENT=

# RUISI 回程入口配置。
INGRESS_HOST=127.0.0.1
INGRESS_PORT=29876
INGRESS_TOKEN=

# Optional RUISI request timeout in milliseconds. Default: 5000.
INGRESS_TIMEOUT_MS=5000

# Optional maximum polling duration in hours. Default: 10. Supported range: > 0 and <= 596.52 (2147483647 ms).
# Polling stops automatically when the duration is reached and can be started again by the next start command.
POLLING_MAX_DURATION_HOURS=10
