# 执行器启动配置
PORT=18035

# 展厅 Token 映射（必填）：token:exhibitionId[,token:exhibitionId...]
# Token：16-512 位高强度随机串，不要提交真实值；exhibitionId：1-64 位 [A-Za-z0-9_-]，仅用于路由。
HC_TOKEN_MAP=example-token-a-0123456789abcdef:exhibition-a,example-token-b-0123456789abcdef:exhibition-b
# 示例值会被启动校验拒绝（example-*/REPLACE_WITH_*/change-me-*），必须替换为真实 Token。

# 每个展厅一组回程配置。变量名 = HC_HALL_<展厅ID大写，非字母数字转下划线>_<字段>。
# 会议智能体的正式 AGENT 由产品确认后填写；两个展厅的 AGENT 不得相同，回程 HOST:PORT 也不得相同。
HC_HALL_EXHIBITION_A_AGENT=
HC_HALL_EXHIBITION_A_INGRESS_HOST=127.0.0.1
HC_HALL_EXHIBITION_A_INGRESS_PORT=29876
HC_HALL_EXHIBITION_A_INGRESS_TOKEN=
# 可选：覆盖该展厅回程接收方 JID；缺省使用执行器内置默认值。
# HC_HALL_EXHIBITION_A_TO=

HC_HALL_EXHIBITION_B_AGENT=
HC_HALL_EXHIBITION_B_INGRESS_HOST=127.0.0.1
HC_HALL_EXHIBITION_B_INGRESS_PORT=29877
HC_HALL_EXHIBITION_B_INGRESS_TOKEN=
# HC_HALL_EXHIBITION_B_TO=

# 如需第三个展厅（例如 HC-C6N3R5），按同一规则追加一组变量；
# 未出现在 HC_TOKEN_MAP 中的展厅不会加载，但已映射的展厅缺少配置会导致启动失败。
# HC_HALL_EXHIBITION_C_AGENT=
# HC_HALL_EXHIBITION_C_INGRESS_HOST=
# HC_HALL_EXHIBITION_C_INGRESS_PORT=
# HC_HALL_EXHIBITION_C_INGRESS_TOKEN=

# 单展厅兼容：当 HC_TOKEN_MAP 只映射一个展厅时，以下旧变量可作为该展厅的回退值。
# AGENT=
# INGRESS_HOST=
# INGRESS_PORT=
# INGRESS_TOKEN=

# Optional RUISI request timeout in milliseconds. Default: 5000.
INGRESS_TIMEOUT_MS=5000

# Optional maximum polling duration in hours. Default: 10. Supported range: > 0 and <= 596.52 (2147483647 ms).
# Polling stops automatically when the duration is reached and can be started again by the next start command.
POLLING_MAX_DURATION_HOURS=10
